{
  "openapi": "3.0.0",
  "info": {
    "title": "Sample Swagger API for Testing DTOs",
    "description": "This JSON file contains various schemas to test the Swagger DTO Generator.",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          },
          "score": {
            "type": "number",
            "format": "float"
          },
          "wallet_balance": {
            "type": "number",
            "format": "decimal"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "profile": {
            "$ref": "#/components/schemas/ProfileDto"
          }
        }
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "age": {
            "type": "integer",
            "format": "int32"
          },
          "avatar_url": {
            "type": "string"
          }
        }
      },
      "ItemDto": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "OrderDto": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "integer",
            "format": "int64"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemDto"
            }
          },
          "total_price": {
            "type": "number",
            "format": "decimal"
          },
          "is_shipped": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
